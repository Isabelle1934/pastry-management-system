# Produção (infra/docker-compose.prod.yml). Copie para .env.prod NO SERVIDOR e preencha.
# NUNCA versione o .env.prod. Gere senhas longas e aleatórias, ex.: openssl rand -base64 32

# --- Endereço do site ---
# Domínio que aponta para o servidor (o Caddy emite o certificado HTTPS automaticamente).
SITE_ADDRESS=encomendas.exemplo.com.br
# Mesmo endereço, com https:// (usado no link de redefinição de senha).
APP_PUBLIC_BASE_URL=https://encomendas.exemplo.com.br
APP_COOKIE_SECURE=true

# --- PostgreSQL ---
POSTGRES_DB=confeitaria
POSTGRES_USER=confeitaria
POSTGRES_PASSWORD=

# --- Conta administrativa inicial ---
# Criada só na primeira inicialização. A senha é provisória (mín. 10 caracteres) e será trocada
# no primeiro acesso. Depois do primeiro login, apague APP_ADMIN_INITIAL_PASSWORD e reinicie.
APP_ADMIN_EMAIL=
APP_ADMIN_NAME=
APP_ADMIN_INITIAL_PASSWORD=

# --- E-mail (SMTP do provedor escolhido) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
APP_MAIL_FROM=

# --- Backups ---
# Pasta no servidor (relativa a infra/) onde ficam os backups diários; copie-a para fora do servidor.
BACKUP_DIR=../backups
BACKUP_KEEP_DAYS=14
