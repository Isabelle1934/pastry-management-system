# Copie para .env e ajuste. NUNCA versione o arquivo .env.
# Os valores abaixo são apenas para desenvolvimento local. Em produção use senhas fortes e exclusivas.

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_DB=confeitaria
POSTGRES_USER=confeitaria
POSTGRES_PASSWORD=confeitaria_dev
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
# Perfis: dev (local) | prod (servidor). Sem perfil, a aplicação não sobe sem DB_URL.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/confeitaria
DB_USERNAME=confeitaria
DB_PASSWORD=confeitaria_dev
# Origens permitidas para CORS, separadas por vírgula. Em produção deixe vazio (mesma origem).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Cookies com flag Secure (exige HTTPS). Em desenvolvimento local: false. Em produção: true.
APP_COOKIE_SECURE=false
# Endereço público do site (usado no link de redefinição de senha).
APP_PUBLIC_BASE_URL=http://localhost:5173

# --- Conta administrativa inicial ---
# Criada apenas na primeira inicialização, se não existir nenhuma conta.
# A senha é provisória (mínimo 10 caracteres) e precisa ser trocada no primeiro acesso.
# Depois de criada, remova APP_ADMIN_INITIAL_PASSWORD do ambiente.
APP_ADMIN_EMAIL=
APP_ADMIN_NAME=
APP_ADMIN_INITIAL_PASSWORD=

# --- E-mail (SMTP) ---
# Desenvolvimento: Mailpit do docker-compose.dev.yml (interface em http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
APP_MAIL_FROM=nao-responda@localhost

# --- Frontend (Vite, apenas desenvolvimento) ---
VITE_API_PROXY_TARGET=http://localhost:8080
