# Copie para .env e ajuste. NUNCA versione o arquivo .env.
# Os valores abaixo são apenas para desenvolvimento local. Em produção use senhas fortes e exclusivas.

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_DB=confeitaria
POSTGRES_USER=confeitaria
POSTGRES_PASSWORD=confeitaria_dev
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
# Perfis: dev (local) | prod (servidor). Sem perfil, a aplicação não sobe sem DB_URL.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/confeitaria
DB_USERNAME=confeitaria
DB_PASSWORD=confeitaria_dev
# Origens permitidas para CORS, separadas por vírgula. Em produção deixe vazio (mesma origem).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite, apenas desenvolvimento) ---
VITE_API_PROXY_TARGET=http://localhost:8080
